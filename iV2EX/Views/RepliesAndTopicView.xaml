<Page
    x:Class="iV2EX.Views.RepliesAndTopicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:iV2EX.Util"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:iV2EX.Model"
    xmlns:localcontrol="using:iV2EX.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <converter:StringToImageSourceConverter x:Key="ImageConverter" />

        <Style x:Key="TransparentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.78" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UsernameButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppBrandBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppBrandBrush}" />
                                            <Setter Target="Root.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppBrandSolidBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.88" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThanksButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border
                                x:Name="HoverOverlay"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.75" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NodeBadgeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource AppBrandHoverBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppBrandBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource AppBrandPressedBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppBrandBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ===== Top Author & Action Bar =====  -->
        <Grid
            Grid.Row="0"
            Padding="20,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">

            <!--  Author Avatar  -->
            <Button
                x:Name="TImagePanel"
                Grid.Column="0"
                Click="AuthorButton_Click"
                Style="{StaticResource TransparentButtonStyle}"
                Tag="{x:Bind Topic.Member.Username, Mode=OneWay}"
                ToolTipService.ToolTip="查看作者主页">
                <localcontrol:AvatarImage
                    AvatarSize="40"
                    ImageUrl="{x:Bind Topic.Member.Image, Mode=OneWay}" />
            </Button>

            <!--  Author Name, Node Badge & Date  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="UsernamePanel"
                        Click="UsernameButton_Click"
                        Style="{StaticResource UsernameButtonStyle}"
                        Tag="{x:Bind Topic.Member.Username, Mode=OneWay}"
                        ToolTipService.ToolTip="点击 @ 作者">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind Topic.Member.Username, Mode=OneWay}" />
                    </Button>
                    <Button
                        x:Name="NodeButton"
                        VerticalAlignment="Center"
                        Click="NodeButton_Click"
                        Style="{StaticResource NodeBadgeButtonStyle}"
                        ToolTipService.ToolTip="进入节点"
                        Visibility="{x:Bind converter:Converter.EmptyToVisibility(Topic.NodeName), Mode=OneWay}">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Text="{x:Bind Topic.NodeName, Mode=OneWay}" />
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="ReplyDatePanel"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Topic.CreateDate, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!--  Action Buttons  -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Height="32"
                    Padding="10,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    ToolTipService.ToolTip="回复总数">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8BD;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind Topic.Replies, Mode=OneWay}" />
                            <Run Text="回复" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Button
                    x:Name="CollectedPanel"
                    Click="CollectButton_Click"
                    Style="{StaticResource HeaderActionButtonStyle}"
                    ToolTipService.ToolTip="收藏 / 取消收藏">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon
                            FontSize="13"
                            Glyph="{x:Bind converter:Converter.CollectToGlyph(Topic.IsCollected), Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind converter:Converter.CollectToText(Topic.IsCollected), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CopyLinkPanel"
                    Click="CopyLinkButton_Click"
                    Style="{StaticResource HeaderActionButtonStyle}"
                    ToolTipService.ToolTip="复制主题链接">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        <TextBlock VerticalAlignment="Center" Text="复制" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  ===== Topic Content & Replies =====  -->
        <Grid Grid.Row="1">
            <ListView
                x:Name="NewsList"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind Replies}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Header>
                    <StackPanel Visibility="{x:Bind converter:Converter.EmptyToVisibility(Topic.Title), Mode=OneWay}">
                        <StackPanel
                            Padding="20,16,20,16"
                            Spacing="12">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                LineHeight="28"
                                Text="{x:Bind Topic.Title, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <localcontrol:HtmlTextBlock
                                FontSize="15"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind Topic.Content, Mode=OneWay}"
                                Visibility="{x:Bind converter:Converter.EmptyToVisibility(Topic.Content), Mode=OneWay}" />
                            <ItemsControl
                                ItemsSource="{x:Bind Topic.Postscript, Mode=OneWay}"
                                Visibility="{x:Bind converter:Converter.HasItemsToVisibility(Topic.Postscript), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="data:TopicModel">
                                        <Border
                                            Margin="0,6,0,0"
                                            Padding="12,8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource AppBrandBadgeBrush}"
                                            BorderThickness="3,0,0,0"
                                            CornerRadius="4">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind LastReply}" />
                                                <localcontrol:HtmlTextBlock
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{x:Bind Content}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </StackPanel>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:ReplyModel">
                        <Border
                            Padding="20,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <!--  Reply Avatar  -->
                                <Button
                                    Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Click="AuthorButton_Click"
                                    Style="{StaticResource TransparentButtonStyle}"
                                    Tag="{x:Bind Username}"
                                    ToolTipService.ToolTip="查看用户主页">
                                    <localcontrol:AvatarImage
                                        AvatarSize="36"
                                        ImageUrl="{x:Bind Avater}" />
                                </Button>

                                <!--  Reply Header & Body  -->
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    VerticalAlignment="Center"
                                                    Click="ReplyToButton_Click"
                                                    Style="{StaticResource UsernameButtonStyle}"
                                                    Tag="{x:Bind Username}"
                                                    ToolTipService.ToolTip="点击 @ TA">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Username}" />
                                                </Button>
                                                <Border
                                                    Height="18"
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource AppBrandSubtleBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind IsLz}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AppBrandBrush}"
                                                        LineHeight="14"
                                                        Text="楼主" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AppBrandBrush}"
                                                    Text="{x:Bind Floor}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind ReplyDate}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Reply Action: Thanks  -->
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Background="{x:Bind converter:Converter.ThanksToBackground(IsThanked), Mode=OneWay}"
                                            Click="ThanksButton_Click"
                                            Foreground="{x:Bind converter:Converter.ThanksToForeground(IsThanked), Mode=OneWay}"
                                            Style="{StaticResource ThanksButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="发送感谢 (10铜币)">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="11" Glyph="&#xEB51;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind converter:Converter.ThanksToText(Thanks), Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <localcontrol:HtmlTextBlock
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind Content}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressBar
                x:Name="LoadingBar"
                VerticalAlignment="Top"
                Foreground="{ThemeResource AppBrandBrush}"
                IsHitTestVisible="False"
                IsIndeterminate="True"
                Visibility="Collapsed" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AppBrandBrush}"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <!--  ===== Adaptive Multiline Reply Composer =====  -->
        <Border
            x:Name="ReplyPanel"
            Grid.Row="2"
            Padding="16,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox
                    x:Name="ReplyText"
                    Grid.Column="0"
                    MinHeight="36"
                    MaxHeight="140"
                    AcceptsReturn="True"
                    FontSize="14"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="写下你的回复..."
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="Send"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SendButtonStyle}"
                    ToolTipService.ToolTip="发送回复">
                    <SymbolIcon Symbol="Send" />
                </Button>
            </Grid>
        </Border>

        <localcontrol:ToastTips
            x:Name="Toast"
            Grid.Row="0"
            Grid.RowSpan="3"
            VerticalAlignment="Top" />
    </Grid>
</Page>
