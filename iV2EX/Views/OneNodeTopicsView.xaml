<Page
    x:Class="iV2EX.Views.OneNodeTopicsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:iV2EX.Util"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localcontrol="using:iV2EX.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:iV2EX.Model"
    x:Name="OneNodeTopicsPage"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ListView
            Name="NodeTopcisList"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource TopicListItemStyle}"
            ItemsSource="{x:Bind NotifyData}"
            SelectionMode="None">
            <ListView.Header>
                <Border
                    Padding="16,14"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Image
                                x:Name="CoverPanel"
                                Source="{x:Bind Node.Cover, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Name="TitlePanel"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind Node.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="主题数量 " />
                                <Run Text="{x:Bind Node.Topics, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button
                            Name="CollectNode"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{x:Bind Node.IsCollect, Mode=OneWay}"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Visibility="{x:Bind converter:Converter.EmptyToVisibility(Node.IsCollect), Mode=OneWay}" />
                    </Grid>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:TopicModel">
                    <Border
                        Padding="14,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Spacing="6">
                                <localcontrol:AvatarImage
                                    AvatarSize="38"
                                    ImageUrl="{x:Bind Member.Image}" />
                                <Border
                                    MinWidth="28"
                                    Padding="6,1"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource AppBrandBadgeBrush}"
                                    CornerRadius="9">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{x:Bind Replies}"
                                        TextAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <Grid
                                Grid.Column="1"
                                RowDefinitions="*,Auto"
                                RowSpacing="6">
                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MaxLines="3"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />

                                <Grid
                                    Grid.Row="1"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Member.Username}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind LastReply}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ProgressBar
            x:Name="LoadingBar"
            VerticalAlignment="Top"
            Foreground="{ThemeResource AppBrandBrush}"
            IsHitTestVisible="False"
            IsIndeterminate="True"
            Visibility="Collapsed" />
        <ProgressRing
            x:Name="LoadingRing"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource AppBrandBrush}"
            IsActive="False"
            Visibility="Collapsed" />
        <StackPanel
            x:Name="ErrorPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="加载失败，请检查网络后重试" />
            <Button
                x:Name="RetryButton"
                HorizontalAlignment="Center"
                Content="重新加载" />
        </StackPanel>
    </Grid>
</Page>
