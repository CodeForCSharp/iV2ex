<Page
    x:Class="iV2EX.Views.BrowseHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:iV2EX.Util"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localcontrol="using:iV2EX.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:iV2EX.Model"
    mc:Ignorable="d">
    <Page.Resources>
        <converter:StringToImageSourceConverter x:Key="ImageConverter" />
        <DataTemplate x:Name="HistoryTemplate" x:DataType="model:BrowseHistoryItem">
            <Border
                Padding="14,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="DeleteItem_Click" Tag="{x:Bind}" Text="删除" />
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <localcontrol:AvatarImage
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        AvatarSize="38"
                        ImageUrl="{x:Bind Image}" />
                    <Grid
                        Grid.Column="1"
                        RowDefinitions="*,Auto"
                        RowSpacing="6">
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            MaxLines="3"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8">
                            <Border
                                Grid.Column="0"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind converter:Converter.EmptyToVisibility(NodeName)}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind NodeName}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Username}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind converter:Converter.TimestampToString(ViewedAt)}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Padding="16,12,12,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="浏览历史" />
            <HyperlinkButton
                x:Name="ClearButton"
                Grid.Column="1"
                Click="Clear_Click"
                Content="清空" />
        </Grid>
        <ListView
            x:Name="HistoryList"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="HistoryList_ItemClick"
            ItemContainerStyle="{StaticResource TopicListItemStyle}"
            ItemTemplate="{StaticResource HistoryTemplate}"
            ItemsSource="{x:Bind Items}"
            SelectionMode="None" />
        <TextBlock
            x:Name="EmptyHint"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="暂无浏览记录"
            Visibility="Collapsed" />
    </Grid>
</Page>
