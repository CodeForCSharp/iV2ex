<Page
    x:Class="iV2EX.Views.PeopleNotificationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:iV2EX.Util"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:iV2EX.Model"
    xmlns:localcontrol="using:iV2EX.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PeopleNotificationPage"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Name="NotificationTemplate" x:DataType="data:NotificationModel">
            <Border
                Padding="14,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <localcontrol:AvatarImage
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        AvatarSize="36"
                        ImageUrl="{x:Bind Member.Image}" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock
                                Grid.Column="0"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind Title}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ReplyDate}" />
                        </Grid>
                        <Border
                            Padding="10,6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{x:Bind converter:Converter.EmptyToVisibility(Content)}">
                            <TextBlock
                                FontSize="13.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Content}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ListView
            Name="NotificationList"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource TopicListItemStyle}"
            ItemTemplate="{StaticResource NotificationTemplate}"
            ItemsSource="{x:Bind NotifyData}"
            SelectionMode="None" />
        <ProgressBar
            x:Name="LoadingBar"
            VerticalAlignment="Top"
            Foreground="{ThemeResource AppBrandBrush}"
            IsHitTestVisible="False"
            IsIndeterminate="True"
            Visibility="Collapsed" />
        <ProgressRing
            x:Name="LoadingRing"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource AppBrandBrush}"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
