<Page
    x:Class="iV2EX.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fragments="using:iV2EX.Fragments"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="BottomNavRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="RootGrid"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border
                                x:Name="HoverOverlay"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="SelectedOverlay"
                                Background="{ThemeResource AppBrandSubtleBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="SelectedIndicator"
                                Width="28"
                                Height="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AppBrandBrush}"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                            <Setter Target="RootGrid.Opacity" Value="0.78" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedOverlay.Opacity" Value="1" />
                                            <Setter Target="SelectedIndicator.Opacity" Value="1" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppBrandBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftPanel.Width" Value="460" />
                        <Setter Target="DividerCol.Width" Value="1" />
                        <Setter Target="RightPanel.Width" Value="*" />
                        <Setter Target="PaneDivider.Visibility" Value="Visible" />
                        <Setter Target="LeftPaneContainer.(Grid.Column)" Value="0" />
                        <Setter Target="LeftPaneContainer.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RightFrame.(Grid.Column)" Value="2" />
                        <Setter Target="RightFrame.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftPanel.Width" Value="*" />
                        <Setter Target="DividerCol.Width" Value="0" />
                        <Setter Target="RightPanel.Width" Value="0" />
                        <Setter Target="PaneDivider.Visibility" Value="Collapsed" />
                        <Setter Target="LeftPaneContainer.(Grid.Column)" Value="0" />
                        <Setter Target="LeftPaneContainer.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="RightFrame.(Grid.Column)" Value="0" />
                        <Setter Target="RightFrame.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanel" Width="460" />
            <ColumnDefinition x:Name="DividerCol" Width="1" />
            <ColumnDefinition x:Name="RightPanel" Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ===== Left Master Pane: Section Content + Bottom Navigation Bar =====  -->
        <Grid
            x:Name="LeftPaneContainer"
            Grid.Column="0"
            RowDefinitions="*,Auto,Auto">
            <!--  Section Views  -->
            <Grid Grid.Row="0">
                <fragments:CollectedTopicsFragment x:Name="HomeView" Visibility="Visible" />
                <fragments:NodesFragment x:Name="NodesView" Visibility="Collapsed" />
                <fragments:UserInfoFragment x:Name="UserInfoView" Visibility="Collapsed" />
            </Grid>

            <!--  Content / Bottom Bar Divider  -->
            <Border
                Grid.Row="1"
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Bottom Navigation Bar  -->
            <Grid
                Grid.Row="2"
                Height="52"
                Padding="4,0"
                ColumnDefinitions="*,*,*">
                <RadioButton
                    x:Name="NavHome"
                    Grid.Column="0"
                    Checked="NavRadio_Checked"
                    GroupName="MainBottomNav"
                    IsChecked="True"
                    Style="{StaticResource BottomNavRadioStyle}"
                    Tag="home">
                    <StackPanel Spacing="1">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="17"
                            Glyph="&#xE80F;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="首页" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    x:Name="NavNodes"
                    Grid.Column="1"
                    Checked="NavRadio_Checked"
                    GroupName="MainBottomNav"
                    Style="{StaticResource BottomNavRadioStyle}"
                    Tag="nodes">
                    <StackPanel Spacing="1">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="17"
                            Glyph="&#xE71D;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="节点" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    x:Name="NavProfile"
                    Grid.Column="2"
                    Checked="NavRadio_Checked"
                    GroupName="MainBottomNav"
                    Style="{StaticResource BottomNavRadioStyle}"
                    Tag="profile">
                    <StackPanel Spacing="1">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="17"
                            Glyph="&#xE77B;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="我的" />
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Grid>

        <!--  ===== Master / Detail Divider =====  -->
        <Border
            x:Name="PaneDivider"
            Grid.Column="1"
            Width="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  ===== Right Detail Frame =====  -->
        <Frame
            x:Name="RightFrame"
            Grid.Column="2" />
    </Grid>
</Page>
