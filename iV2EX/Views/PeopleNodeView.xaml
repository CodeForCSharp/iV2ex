<Page
    x:Class="iV2EX.Views.PeopleNodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:iV2EX.Model"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PeopleNodePage"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Name="NodesTemplate" x:DataType="data:NodeModel">
            <Border
                Width="136"
                Height="128"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <Border
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <Image
                            Name="ImagePanel"
                            Source="{x:Bind Image}"
                            Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        Name="TitlePanel"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind Topics}" />
                        <Run Text=" 主题" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <GridView
            Name="PeopleNodeList"
            Padding="12"
            IsItemClickEnabled="True"
            ItemTemplate="{StaticResource NodesTemplate}"
            SelectionMode="None"
            ShowsScrollingPlaceholders="True" />
        <ProgressRing
            x:Name="LoadingRing"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource AppBrandBrush}"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
