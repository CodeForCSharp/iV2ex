<UserControl
    x:Class="iV2EX.Fragments.CollectedTopicsFragment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:iV2EX.Util"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localcontrol="using:iV2EX.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:iV2EX.Model"
    xmlns:tuple="using:iV2EX.TupleModel"
    x:Name="NewsFragment"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="TopicTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border
                                x:Name="HoverOverlay"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.75" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ===== Multi-line Wrapping Tab Bar + Refresh Button =====  -->
        <Grid
            Grid.Row="0"
            Padding="10,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="6">
            <ItemsControl
                x:Name="LabelPanel"
                Grid.Column="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <localcontrol:WrapPanel HorizontalSpacing="3" VerticalSpacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tuple:CollectedListModel">
                        <Button
                            Background="{x:Bind converter:Converter.TabToBackground(IsSelected), Mode=OneWay}"
                            Click="TabButton_Click"
                            Foreground="{x:Bind converter:Converter.TabToForeground(IsSelected), Mode=OneWay}"
                            Style="{StaticResource TopicTabButtonStyle}"
                            Tag="{x:Bind}">
                            <TextBlock
                                FontSize="14"
                                Text="{x:Bind Text}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
                x:Name="Refresh"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="Refresh_Click"
                Style="{StaticResource RefreshIconButtonStyle}"
                ToolTipService.ToolTip="刷新当前分类">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!--  ===== Topic List =====  -->
        <ListView
            Name="NewsList"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource TopicListItemStyle}"
            ItemsSource="{x:Bind News}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:TopicModel">
                    <Border
                        Padding="14,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Spacing="6">
                                <localcontrol:AvatarImage
                                    AvatarSize="38"
                                    ImageUrl="{x:Bind Member.Image}" />
                                <Border
                                    MinWidth="28"
                                    Padding="6,1"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource AppBrandBadgeBrush}"
                                    CornerRadius="9">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{x:Bind Replies}"
                                        TextAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <Grid
                                Grid.Column="1"
                                RowDefinitions="*,Auto"
                                RowSpacing="6">
                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MaxLines="3"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />

                                <Grid
                                    Grid.Row="1"
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="8">
                                    <Border
                                        Grid.Column="0"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind NodeName}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Member.Username}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind LastReply}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="1"
            VerticalAlignment="Top"
            Foreground="{ThemeResource AppBrandBrush}"
            IsHitTestVisible="False"
            IsIndeterminate="True"
            Visibility="Collapsed" />
        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource AppBrandBrush}"
            IsActive="False"
            Visibility="Collapsed" />
        <StackPanel
            x:Name="ErrorPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="加载失败，请检查网络后重试" />
            <Button
                x:Name="RetryButton"
                HorizontalAlignment="Center"
                Content="重新加载" />
        </StackPanel>
        <localcontrol:ToastTips
            x:Name="Toast"
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalAlignment="Top" />
    </Grid>
</UserControl>
