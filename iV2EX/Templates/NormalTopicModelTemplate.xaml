<ResourceDictionary
    x:Class="iV2EX.Templates.NormalTopicModelTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:iV2EX.Util"
    xmlns:localcontrol="using:iV2EX.Controls"
    xmlns:model="using:iV2EX.Model">
    <DataTemplate x:Key="TopicModelNormalTemplate" x:DataType="model:TopicModel">
        <Border
            Padding="14,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Spacing="6">
                    <localcontrol:AvatarImage
                        AvatarSize="38"
                        ImageUrl="{x:Bind Member.Image}" />
                    <Border
                        MinWidth="28"
                        Padding="6,1"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AppBrandBadgeBrush}"
                        CornerRadius="9">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind Replies}"
                            TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <Grid
                    Grid.Column="1"
                    RowDefinitions="*,Auto"
                    RowSpacing="6">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MaxLines="3"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="8">
                        <Border
                            Grid.Column="0"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind converter:Converter.EmptyToVisibility(NodeName)}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind NodeName}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Member.Username}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind LastReply}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
